{
  "name": "lgr-webgl-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LGR WebGL Lab — an npm-workspaces monorepo: a reusable @lgr/engine-core + per-project apps (city showcase, John's office, The Hoard). Built end-to-end for learning Three.js + GLSL.",
  "workspaces": [
    "packages/*",
    "projects/*"
  ],
  "scripts": {
    "prepare": "bash tools/install-hooks.sh || true",
    "check:shaders": "node tools/check-shader-backticks.mjs",
    "prebuild": "npm run check:shaders",
    "prebuild:lib": "npm run check:shaders",
    "build": "npm run build -w projects/city && npm run build -w projects/office && npm run build -w projects/hoard && npm run build -w projects/hoard2 && npm run build -w projects/metropolis && npm run build -w projects/showcase-lab && npm run build -w projects/lessons && npm run build -w projects/tracer && npm run build -w projects/atlas && npm run build -w projects/swing-lab",
    "build:atlas": "npm run build -w projects/atlas",
    "build:city": "npm run build -w projects/city",
    "build:office": "npm run build -w projects/office",
    "build:hoard": "npm run build -w projects/hoard",
    "build:hoard2": "npm run build -w projects/hoard2",
    "hoard2-capture": "node tools/hoard2-capture.mjs",
    "build:metropolis": "npm run build -w projects/metropolis",
    "build:showcase-lab": "npm run build -w projects/showcase-lab",
    "dev": "npm run dev -w projects/city",
    "preview": "npm run preview -w projects/city",
    "tier-guard": "node tools/tier-guard.mjs --serve projects/city/dist",
    "tier-guard:update": "node tools/tier-guard.mjs --update --serve projects/city/dist",
    "smoke": "node tools/smoke.mjs",
    "attract-probe": "node tools/attract-probe.mjs",
    "dive-probe": "node tools/dive-probe.mjs",
    "consumer-probe": "node tools/consumer-probe.mjs",
    "egg-probe": "node tools/egg-probe.mjs",
    "mobile-cockpit-probe": "node tools/mobile-cockpit-probe.mjs",
    "night-sky-probe": "node tools/night-sky-probe.mjs --serve projects/city/dist",
    "cwv-probe": "node tools/cwv-probe.mjs",
    "scroll-probe": "node tools/scroll-probe.mjs",
    "narrative-probe": "node tools/narrative-probe.mjs",
    "2d-layer-probe": "node tools/2d-layer-probe.mjs",
    "swing-probe": "node tools/swing-composition-probe.mjs",
    "character-probe": "node tools/character-probe.mjs",
    "test": "node --test packages/engine-core/src/*.test.mjs packages/engine-core/src/math/*.test.mjs packages/engine-core/src/hero/*.test.mjs tools/*.test.mjs projects/hoard2/src/*/*.test.mjs",
    "asset-factory": "node asset-factory/process.mjs",
    "asset-factory:riso": "node asset-factory/process-riso.mjs",
    "build:lib": "npm run build:lib -w packages/engine-core",
    "hero-fps": "node tools/hero-fps.mjs",
    "before-after-probe": "node tools/before-after-probe.mjs",
    "look-reel-probe": "node tools/look-reel-probe.mjs",
    "capture-hero-wipe": "node tools/capture-hero-wipe.mjs",
    "present-parity": "node tools/present-parity.mjs",
    "present-parity:update": "node tools/present-parity.mjs --update",
    "beauty-legibility": "node tools/beauty-legibility-guard.mjs",
    "beauty-legibility:prove-red": "node tools/beauty-legibility-guard.mjs --prove-red",
    "capture-camera-director": "node tools/capture-camera-director.mjs",
    "capture-build-in": "node tools/capture-build-in.mjs",
    "capture-shadows": "node tools/capture-shadows.mjs",
    "hoard2-webkit": "node tools/hoard2-webkit-lane.mjs",
    "hoard2-timelapse": "node tools/hoard2-timelapse.mjs",
    "vendor-drift-guard": "node tools/vendor-drift-guard.mjs",
    "vendor-drift-guard:live-sky": "node tools/vendor-drift-guard.mjs --project ~/dev/lgr-live-sky",
    "vendor-drift-guard:image-studio": "node tools/vendor-drift-guard.mjs --project ~/dev/lgr-image-studio",
    "vendor-drift-guard:all": "node tools/vendor-drift-guard-all.mjs",
    "verify": "bash tools/verify-local.sh",
    "verify:fast": "bash tools/verify-local.sh --fast",
    "build:swing-lab": "npm run build -w projects/swing-lab",
    "swing-lab-probe": "node tools/swing-lab-probe.mjs",
    "city-legibility": "node tools/city-legibility.mjs",
    "city-swing-reel": "node tools/city-swing-reel.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.49.0",
    "vite": "^8.0.14",
    "vite-plugin-glsl": "^1.6.0"
  }
}
